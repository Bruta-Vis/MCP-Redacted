{
  "name": "mcp-privacy-gateway",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "0.1.0",
  "description": "MCP privacy gateway: proxies internal MCP servers and redacts PII before results reach the model. Built on mcp-use.",
  "author": "Matthew Grayson",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "dev": "mcp-use dev",
    "dev:crm": "tsx demo/crm-server.ts",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "mcp-use typecheck",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@mcp-use/client": "^2.4.4",
    "mcp-use": "2.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
