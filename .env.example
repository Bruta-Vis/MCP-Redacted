# Upstream MCP servers to proxy, keyed by namespace. Tools mount as <namespace>_<tool>.
# HTTP:  { "crm": { "url": "https://crm.internal/mcp", "authToken": "..." } }
# stdio: { "files": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/data"] } }
GATEWAY_UPSTREAMS={"crm":{"url":"http://localhost:3001/mcp"}}

# Whole-word terms to always redact (account names, codenames). Comma-separated.
GATEWAY_SENSITIVE_TERMS=Acme Health,Northwind Clinics

# Optional: restrict which kinds are redacted. Default is all of:
# EMAIL,PHONE,SSN,CREDIT_CARD,IP_ADDRESS,SECRET,TERM,PERSON_NAME,ADDRESS,DATE_OF_BIRTH
# GATEWAY_ENABLED_KINDS=EMAIL,PHONE,SSN,CREDIT_CARD,SECRET
